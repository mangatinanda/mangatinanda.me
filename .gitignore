# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# personal docs (career strategy stays out of git — lives in ~/notes Obsidian vault)
/docs/career-action-plan.md
/docs/career-plan-*.md
/MEMORY.md
# tailored/working resume drafts (application-specific, keep off the public portfolio)
/resume/
# interview prep docs (private, local-only)
/interview/

# agent config & memory
.claude/
.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts
